pipeline {
    agent any
    
    environment {
        // 1. Windows Docker Desktop Fixes
        DOCKER_HOST = 'tcp://host.docker.internal:2375'
        DOCKER_TLS_VERIFY = ''
        
        // 2. App Image Variables
        DOCKER_IMAGE = "chaos-app"
        DOCKER_TAG = "v${env.BUILD_NUMBER}" 
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Pulling code from Git...'
                // Restoring your core Git source checkout step
                git branch: 'main', url: 'https://github.com/leenatacswamyrao/observability_stack.git'
            }
        }

        stage('Security Scan') {
            steps {
                echo 'Scanning for Noisy Neighbors...'
                sh '''
                    if [ -f "project-1/manifests/deployment.yaml" ]; then
                        echo "File exists, checking vital signs..."
                        grep -q "kind: Deployment" project-1/manifests/deployment.yaml && \
                        grep -q "image:" project-1/manifests/deployment.yaml && \
                        echo "YAML Structure looks valid for deployment."
                    else
                        echo "Error: deployment.yaml not found!"
                        exit 1
                    fi
                '''
            }
        }

        stage('Build Image') {
            steps {
                echo "Building Docker Image..."
                sh "docker build --no-cache -t ${DOCKER_IMAGE}:${DOCKER_TAG} project-1/"
            }
        }

        stage('Deploy to K8s') {
            steps {
                echo "Deploying to Local Cluster..."
                withCredentials([string(credentialsId: 'k8s-token', variable: 'K8S_TOKEN')]) {
                    sh """
                        kubectl apply -f project-1/manifests/deployment.yaml \
                        --server=https://host.docker.internal:54150 \
                        --token="${K8S_TOKEN}" \
                        --insecure-skip-tls-verify=true \
                        --validate=false
                    """
                }
            }
        }

        stage('Trigger Integration Tests') {
            steps {
                echo 'Harness/Local deployment step completed. Handoff to test pipeline...'
                // Triggers your brand-new independent testing pipeline and keeps moving
                build job: 'chaos-app-crud-tests', wait: false 
            }
        }
    }

    post {
        always {
            echo 'Pipeline completed. Cleaning up workspace...'
        }
        failure {
            // Your email alerts remain active if the build/deploy breaks before the test phase!
            mail to: 'leenatacswamyrao@gmail.com',
                 subject: "❌ Deployment Failure: Job '${env.JOB_NAME}' [Build #${env.BUILD_NUMBER}]",
                 body: """The main application deployment stage just failed on your branch.
                          
Check the live Jenkins console logs here to debug: ${env.BUILD_URL}console"""
        }
        success {
            echo 'Deployment successfully handed off to integration test suite!'
        }
    }
}
