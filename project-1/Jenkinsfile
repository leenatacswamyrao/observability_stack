pipeline {
    agent any
    
    environment {
        // Tells Docker to use the Windows network port instead of a socket
        DOCKER_HOST = 'tcp://localhost:2375'
        // Disables TLS compliance since our local port runs without it
        DOCKER_TLS_VERIFY = '0'
    }

    environment {
        DOCKER_IMAGE = "chaos-app"
        DOCKER_TAG = "v${env.BUILD_NUMBER}" // Incremental versioning!
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Pulling code from Git...'
                // Jenkins handles this automatically if pointed at a repo
            }
        }

        stage('Security Scan') {
            steps {
                echo 'Scanning for Noisy Neighbors...'
                // SRE Move: Run that validation we did earlier
               sh '''
                    if [ -f "project-1/manifests/deployment.yaml" ]; then
                        echo "File exists, checking vital signs..."
                        grep -q "kind: Deployment" project-1/manifests/deployment.yaml && \
                        grep -q "image:" project-1/manifests/deployment.yaml && \
                        echo "YAML Structure looks valid for deployment."
                    else
                        echo "Error: deployment.yaml not found!"
                        exit 1
                    fi
                '''
            }
        }

        stage('Build Image') {
    steps {
        // This line fixes the permission 'on the fly' if needed
        sh 'sudo chmod 666 /var/run/docker.sock || true' 
        echo "Building Docker Image..."
       // sh 'docker build -t chaos-app:latest -f project-1/Dockerfile project-1/'
        // Tag the image with the specific Jenkins build number (v24, v25, etc.)
        sh "docker build --no-cache -t chaos-app:v${BUILD_NUMBER} project-1/"
    }
}
stage('Deploy to K8s') {
    steps {
        echo "Deploying to Local Cluster..."
        // Ensure the credentialsId matches exactly what you named it in Jenkins
        withCredentials([string(credentialsId: 'k8s-token', variable: 'K8S_TOKEN')]) {
            sh """
                kubectl apply -f project-1/manifests/deployment.yaml \
                --server=https://host.docker.internal:54150 \
                --token="${K8S_TOKEN}" \
                --insecure-skip-tls-verify=true \
                --validate=false
            """
        }
    }
}
    }
}
