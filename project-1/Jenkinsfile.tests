pipeline {
    agent any

    environment {
        // Points to your application namespace/service in the cluster
        K8S_SERVICE = "chaos-app-service" 
    }

    stages {
        stage('Checkout Code') {
            steps {
                // Pulls down your latest tests/crud.spec.js file
                checkout scm
            }
        }

        stage('Establish Environment') {
            steps {
                echo 'Setting up local Node runtime environment...'
                dir('project-1/chaos-app') {
                    sh '''
                        # Download and extract Node.js locally if it doesn't exist
                        if [ ! -d "bin" ]; then
                            curl -fsSL https://nodejs.org/dist/v20.11.1/node-v20.11.1-linux-x64.tar.gz -o node.tar.gz
                            tar -xzf node.tar.gz --strip-components=1
                            rm -f node.tar.gz
                        fi
                        
                        export PATH="$(pwd)/bin:$PATH"
                        npm install
                    '''
                }
            }
        }
    stage('Bridge & Run CRUD Tests') {
    steps {
        // Wrap the shell commands inside your Jenkins cluster credential token context
        withKubeConfig([credentialsId: 'kubernetes-cluster-secret-token', serverUrl: 'https://your-cluster-api-endpoint:6443']) {
            sh '''
            # Now kubectl has permission to fetch resources!
            POD_NAME=$(kubectl get pods -l app=chaos-app -o jsonpath="{.items[0].metadata.name}")
            
            kubectl port-forward pod/${POD_NAME} 5000:5000 > /dev/null 2>&1 &
            TUNNEL_PID=$!
            
            sleep 5
            npx playwright test
            
            kill $TUNNEL_PID
            '''
        }
    }
}
    }
}
