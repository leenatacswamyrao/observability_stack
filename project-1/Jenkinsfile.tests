pipeline {
    agent any

    environment {
        // Points to your application namespace/service in the cluster
        K8S_SERVICE = "chaos-app-service" 
    }

    stages {
        stage('Checkout Code') {
            steps {
                // Pulls down your latest tests/crud.spec.js file
                checkout scm
            }
        }

        stage('Establish Environment') {
            steps {
                echo 'Setting up local Node runtime environment...'
                dir('project-1/chaos-app') {
                    sh '''
                        # Download and extract Node.js locally if it doesn't exist
                        if [ ! -d "bin" ]; then
                            curl -fsSL https://nodejs.org/dist/v20.11.1/node-v20.11.1-linux-x64.tar.gz -o node.tar.gz
                            tar -xzf node.tar.gz --strip-components=1
                            rm -f node.tar.gz
                        fi
                        
                        export PATH="$(pwd)/bin:$PATH"
                        npm install
                    '''
                }
            }
        }

    stage('Bridge & Run CRUD Tests') {
            steps {
                echo 'Establishing network bridge and checking endpoint health...'
                sh '''
                    # 1. Clear any zombie port-forwards
                    pkill -f "port-forward" || true
                    
                    # 2. Start background port forwarding to the service
                    echo "Opening port-forward tunnel..."
                    kubectl port-forward svc/${K8S_SERVICE} 5000:5000 -n flask-project > /dev/null 2>&1 &
                    
                    # 🛑 THE FIX: Give the background process 2 seconds to bind to local port 5000
                    echo "Waiting for local port binding..."
                    sleep 2
                    
                    # 3. Network Polling Gate: Wait up to 2 minutes for the endpoint to respond
                    echo "Polling http://localhost:5000 for a valid response..."
                    ATTEMPTS=0
                    MAX_ATTEMPTS=24 # 24 attempts * 5 seconds = 2 minutes
                    MATCH_FOUND=false

                    while [ $ATTEMPTS -lt $MAX_ATTEMPTS ]; do
                        if curl -s -o /dev/null http://localhost:5000; then
                            echo "✅ Application is live and responding! Proceeding to tests..."
                            MATCH_FOUND=true
                            break
                        fi
                        
                        echo "Endpoint not reachable yet... waiting 5 seconds (Attempt $((ATTEMPTS+1))/$MAX_ATTEMPTS)"
                        sleep 5
                        ATTEMPTS=$((ATTEMPTS+1))
                    done

                    if [ "$MATCH_FOUND" = false ]; then
                        echo "❌ Error: Application endpoint failed to respond within timeout."
                        exit 1
                    fi
                    
                    # 4. Execute the Playwright tests
                    cd project-1/chaos-app/
                    export PATH="$(pwd)/bin:$PATH"
                    page_url="http://host.docker.internal:5000" npx playwright test tests/crud.spec.js
                '''
            }
            post {
                always {
                    echo 'Tearing down port-forward session...'
                    sh 'pkill -f "port-forward" || true'
                }
            }
        }
}
}
