pipeline {
    agent any

    environment {
        // Points to your application namespace/service in the cluster
        K8S_SERVICE = "chaos-app-service" 
    }

    stages {
        stage('Checkout Code') {
            steps {
                // Pulls down your latest tests/crud.spec.js file
                checkout scm
            }
        }

        stage('Establish Environment') {
            steps {
                echo 'Setting up local Node runtime environment...'
                dir('project-1/chaos-app') {
                    sh '''
                        # Download and extract Node.js locally if it doesn't exist
                        if [ ! -d "bin" ]; then
                            curl -fsSL https://nodejs.org/dist/v20.11.1/node-v20.11.1-linux-x64.tar.gz -o node.tar.gz
                            tar -xzf node.tar.gz --strip-components=1
                            rm -f node.tar.gz
                        fi
                        
                        export PATH="$(pwd)/bin:$PATH"
                        npm install
                    '''
                }
            }
        }
      stage('Bridge & Run CRUD Tests') {
    steps {
        sh '''
        # 1. Target the app pod directly using its label (app=chaos-app)
        # Change 'chaos-app' if your deployment uses a different label name
        kubectl port-forward deployment/chaos-app 5000:5000 > /dev/null 2>&1 &
        
        TUNNEL_PID=$!
        
        # 2. Wait until local port 5000 is genuinely accepting traffic
        echo "Waiting for the application tunnel to establish..."
        timeout 15 bash -c 'until printf "" 2>>/dev/null >/dev/tcp/127.0.0.1/5000; do sleep 1; done'
        echo "Application is reachable! Starting tests..."
        
        # 3. Run the tests
        npx playwright test
        
        # 4. Clean up the tunnel safely
        kill $TUNNEL_PID
        '''
    }
}
   }
}
