pipeline {
    agent any

    environment {
        // Points to your application namespace/service in the cluster
        K8S_SERVICE = "chaos-app-service" 
    }

    stages {
        stage('Checkout Code') {
            steps {
                // Pulls down your latest tests/crud.spec.js file
                checkout scm
            }
        }

        stage('Establish Environment') {
            steps {
                echo 'Setting up local Node runtime environment...'
                dir('project-1/chaos-app') {
                    sh '''
                        # Download and extract Node.js locally if it doesn't exist
                        if [ ! -d "bin" ]; then
                            curl -fsSL https://nodejs.org/dist/v20.11.1/node-v20.11.1-linux-x64.tar.gz -o node.tar.gz
                            tar -xzf node.tar.gz --strip-components=1
                            rm -f node.tar.gz
                        fi
                        
                        export PATH="$(pwd)/bin:$PATH"
                        npm install
                    '''
                }
            }
        }
    stage('Bridge & Run CRUD Tests') {
    steps {
        withCredentials([string(credentialsId: 'k8s-token', variable: 'KUBERNETES_TOKEN')]) {
            sh '''
            echo "Configuring cluster context using Docker host bridge..."
            
            kubectl config set-cluster chaos-cluster --server=https://host.docker.internal:54150 --insecure-skip-tls-verify=true
            kubectl config set-credentials jenkins-robot --token="${KUBERNETES_TOKEN}"
            kubectl config set-context chaos-context --cluster=chaos-cluster --user=jenkins-robot
            kubectl config use-context chaos-context

            echo "Locating the application pod inside the flask-project namespace..."
            # FIX: Explicitly target the namespace flag (-n) here to clear the RBAC wall
            POD_NAME=$(kubectl get pods -n flask-project -l app=chaos-app -o jsonpath="{.items[0].metadata.name}")
            echo "Targeting Pod: ${POD_NAME}"
            
            # FIX: Explicitly pass the namespace to the port-forward command as well
            kubectl port-forward -n flask-project pod/${POD_NAME} 5000:5000 > /dev/null 2>&1 &
            TUNNEL_PID=$!
            
            echo "Allowing network proxy bridge to stabilize..."
            sleep 5
            
            echo "Executing Playwright Sequential CRUD Suite..."
            npx playwright test
            
            echo "Cleaning up proxy tunnel..."
            kill $TUNNEL_PID
            '''
        }
    }
}
    }
}
