pipeline {
    agent any

    environment {
        // Points to your application namespace/service in the cluster
        K8S_SERVICE = "chaos-app-service" 
    }

    stages {
        stage('Checkout Code') {
            steps {
                // Pulls down your latest tests/crud.spec.js file
                checkout scm
            }
        }

        stage('Establish Environment') {
            steps {
                echo 'Setting up local Node runtime environment...'
                dir('project-1/chaos-app') {
                    sh '''
                        # Download and extract Node.js locally if it doesn't exist
                        if [ ! -d "bin" ]; then
                            curl -fsSL https://nodejs.org/dist/v20.11.1/node-v20.11.1-linux-x64.tar.gz -o node.tar.gz
                            tar -xzf node.tar.gz --strip-components=1
                            rm -f node.tar.gz
                        fi
                        
                        export PATH="$(pwd)/bin:$PATH"
                        npm install
                    '''
                }
            }
        }

stage('Bridge & Run CRUD Tests') {
            steps {
                echo 'Validating pod readiness using JSONPath and preparing network bridge...'
                sh '''
                    # 1. Clear any zombie port-forwards
                    pkill -f "port-forward" || true
                    
                    # 2. Let Kubernetes natively block until the pod is 100% Ready
                    echo "Waiting for chaos-app pod to reach Ready condition..."
                    if kubectl wait --namespace=flask-project \
                                  --for=condition=Ready \
                                  pod -l app=chaos-app \
                                  --timeout=60s; then
                        echo "✅ Pod is fully ready and accepting traffic!"
                    else
                        echo "❌ Error: Pod did not reach ready state within timeout."
                        exit 1
                    fi                    
                    # 3. Start background port forwarding now that we know a ready pod exists
                    echo "Opening port-forward tunnel to ${K8S_SERVICE}..."
                    kubectl port-forward svc/${K8S_SERVICE} 5000:5000 > /dev/null 2>&1 &
                    
                    # 4. Brief pause for the network tunnel to bind locally
                    sleep 3
                    
                    # 5. Execute the tests
                    cd project-1/chaos-app/
                    export PATH="$(pwd)/bin:$PATH"
                    page_url="http://host.docker.internal:5000" npx playwright test tests/crud.spec.js
                '''
            }
            post {
                always {
                    echo 'Tearing down port-forward session...'
                    sh 'pkill -f "port-forward" || true'
                }
            }
        }   
}
}
