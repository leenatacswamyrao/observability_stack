pipeline {
    agent any

    environment {
        // Points to your application namespace/service in the cluster
        K8S_SERVICE = "chaos-app-service" 
    }

    stages {
        stage('Checkout Code') {
            steps {
                // Pulls down your latest tests/crud.spec.js file
                checkout scm
            }
        }

        stage('Establish Environment') {
            steps {
                echo 'Setting up local Node runtime environment...'
                dir('project-1/chaos-app') {
                    sh '''
                        # Download and extract Node.js locally if it doesn't exist
                        if [ ! -d "bin" ]; then
                            curl -fsSL https://nodejs.org/dist/v20.11.1/node-v20.11.1-linux-x64.tar.gz -o node.tar.gz
                            tar -xzf node.tar.gz --strip-components=1
                            rm -f node.tar.gz
                        fi
                        
                        export PATH="$(pwd)/bin:$PATH"
                        npm install
                    '''
                }
            }
        }
   stage('Bridge & Run CRUD Tests') {
    steps {
        sh '''
        # 1. Start the port forward in the background
        kubectl port-forward svc/postgres-service 5000:5432 > /dev/null 2>&1 &
        
        # Save the process ID of the tunnel so we can clean it up later
        TUNNEL_PID=$!
        
        # 2. CRITICAL FIX: Wait until port 5000 is genuinely accepting connections
        echo "Waiting for kubectl port-forward to establish..."
        timeout 15 bash -c 'until printf "" 2>>/dev/null >/dev/tcp/127.0.0.1/5000; do sleep 1; done'
        echo "Tunnel is alive! Starting tests..."
        
        # 3. Run the tests safely now that the network bridge is open
        npx playwright test
        
        # 4. Clean up the background tunnel process
        kill $TUNNEL_PID
        '''
    }
}
   }
}
