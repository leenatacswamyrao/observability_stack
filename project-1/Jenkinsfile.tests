pipeline {
    agent any

    environment {
        // Points to your application namespace/service in the cluster
        K8S_SERVICE = "chaos-app-service" 
    }

    stages {
        stage('Checkout Code') {
            steps {
                // Pulls down your latest tests/crud.spec.js file
                checkout scm
            }
        }

        stage('Establish Environment') {
            steps {
                echo 'Setting up local Node runtime environment...'
                dir('project-1/chaos-app') {
                    sh '''
                        # Download and extract Node.js locally if it doesn't exist
                        if [ ! -d "bin" ]; then
                            curl -fsSL https://nodejs.org/dist/v20.11.1/node-v20.11.1-linux-x64.tar.gz -o node.tar.gz
                            tar -xzf node.tar.gz --strip-components=1
                            rm -f node.tar.gz
                        fi
                        
                        export PATH="$(pwd)/bin:$PATH"
                        npm install
                    '''
                }
            }
        }
    stage('Bridge & Run CRUD Tests') {
            steps {
                echo 'Validating pod status and launching Playwright test suite...'
                
                withCredentials([string(credentialsId: 'k8s-token', variable: 'K8S_TOKEN')]) {
                    sh '''
                        # 1. Clear any old port-forwards
                        pkill -f "port-forward" || true
                        
                        # 2. Verify the pods are healthy before running tests
                        echo "Checking for '1/1 Running' signature..."
                        POD_STATUS=$(kubectl get pods -l app=chaos-app -n flask-project --no-headers \
                                      --server=https://host.docker.internal:54150 \
                                      --token="${K8S_TOKEN}" \
                                      --insecure-skip-tls-verify=true \
                                      | awk '{print $2 " " $3}' | grep "1/1 Running" || true)
                        
                        if [ -z "$POD_STATUS" ]; then
                            echo "❌ Error: Pods are not reporting '1/1 Running'. Skipping tests."
                            exit 1
                        fi
                        
                        echo "✅ Cluster health verified: ($POD_STATUS)."
                        
                        # 3. Open the port-forward tunnel globally on IPv4
                        echo "Starting network bridge..."
                        kubectl port-forward svc/chaos-app-service 5000:5000 -n flask-project \
                                --address=0.0.0.0 \
                                --server=https://host.docker.internal:54150 \
                                --token="${K8S_TOKEN}" \
                                --insecure-skip-tls-verify=true > /dev/null 2>&1 &
                        
                        # Give the background bridge 3 seconds to latch
                        sleep 3
                        
                        # 4. 🛑 THE FIX: Use the standard Docker IPv4 bridge gateway
                        cd project-1/chaos-app/
                        export PATH="$(pwd)/bin:$PATH"
                        
                        echo "Launching tests against application endpoint..."
                        page_url="http://172.17.0.1:5000" npx playwright test tests/crud.spec.js
                    '''
                }
            }
            post {
                always {
                    echo 'Cleaning up network bridge...'
                    sh 'pkill -f "port-forward" || true'
                }
            }
        }
   }
}
